    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "undici": "^7.2.0",
    "viem": "^2.53.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
